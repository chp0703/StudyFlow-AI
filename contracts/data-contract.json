      ],
      "invariants": [
        "Mutations acquire SELECT ... FOR UPDATE on app_private.user_profiles under existing owner-lock order and verify active unexpired API receipt lease/fingerprint",
        "Initialize is first-write-wins for same owner/source/origin receipt/fingerprint; checkpoint WAIT and ADVANCE use CAS on (version, cursor) with exact-once contiguous completed_steps prefix 0..cursor-1",
        "Completed records are retained for at least the 7-day receipt retry window; live awaiting continuations are never deleted by lease or product TTL",
        "ENABLE/FORCE RLS with same-owner auth.uid() policy; sf_rpc_owner receives least touched-table privileges only, with no PUBLIC/anon/authenticated direct table access"
      ],
