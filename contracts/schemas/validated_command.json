        "schema_version": {
          "const": "1.1"
        },
        "operation": {
          "const": "get_study_plan"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "view": {
              "enum": [
                "CURRENT",
                "HISTORY",
                "PROPOSAL"
              ]
            },
            "version": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "start_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "view",
            "version",
            "proposal_id",
            "start_at",
            "end_at"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "view": {
                    "const": "CURRENT"
                  }
                }
              },
              "then": {
                "properties": {
                  "version": {
                    "type": "null"
                  },
                  "proposal_id": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "view": {
                    "const": "HISTORY"
                  }
                }
              },
              "then": {
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "proposal_id": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "view": {
                    "const": "PROPOSAL"
                  }
                }
              },
              "then": {
                "properties": {
                  "version": {
                    "type": "null"
                  },
                  "proposal_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
