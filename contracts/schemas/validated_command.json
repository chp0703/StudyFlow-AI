  "$defs": {
    "candidate_fields": {
      "type": "object",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "course_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "available_from_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline_precision": {
          "anyOf": [
            {
              "enum": [
                "DATE",
                "DATETIME"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline_timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "estimated_minutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "LOW",
                "NORMAL",
                "HIGH"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "policy_patch": {
      "type": "object",
      "properties": {
        "min_block_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_block_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "allow_short_final_block": {
          "type": "boolean"
        },
        "max_daily_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "break_minutes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "time_window": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "AVAILABILITY",
            "BUSY"
          ]
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "recurrence": {
          "enum": [
            "NONE",
            "WEEKLY"
          ]
        },
        "timezone": {
          "type": "string"
        },
        "start_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "weekday": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            {
              "type": "null"
            }
          ]
        },
        "start_time": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_time": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                {
                  "const": "24:00"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "label",
        "recurrence",
        "timezone",
        "start_at",
        "end_at",
        "weekday",
        "start_time",
        "end_time",
        "valid_from",
        "valid_until"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "recurrence": {
                "const": "NONE"
              }
            }
          },
          "then": {
            "properties": {
              "weekday": {
                "type": "null"
              },
              "start_time": {
                "type": "null"
              },
              "end_time": {
                "type": "null"
              },
              "valid_from": {
                "type": "null"
              },
              "valid_until": {
                "type": "null"
              },
              "start_at": {
                "type": "string",
                "format": "date-time"
              },
              "end_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "else": {
            "properties": {
              "start_at": {
                "type": "null"
              },
              "end_at": {
                "type": "null"
              },
              "weekday": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "start_time": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "end_time": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  {
                    "const": "24:00"
                  }
                ]
              },
              "valid_from": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "selection_mode": {
          "enum": [
            "ALL_ELIGIBLE",
            "SELECTED_TASKS"
          ]
        },
        "task_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "start_at",
        "end_at",
        "selection_mode",
        "task_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "selection_mode": {
                "const": "ALL_ELIGIBLE"
              }
            }
          },
          "then": {
            "properties": {
              "task_ids": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "task_ids": {
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        }
      ]
    }
  }
}
