# Store binary assets in Git LFS so images are checked out as real files.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text


# Evaluation inputs are hashed (SHA-256); keep them byte-identical across platforms.
backend/tests/fixtures/assessment_eval/*.json text eol=lf
backend/tests/fixtures/nlu_*.json text eol=lf
docs/features/assessment/evaluation/results/annotations/*.csv text eol=lf
